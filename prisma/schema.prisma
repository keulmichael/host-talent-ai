generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id              String      @id
  name            String
  retentionMonths Int         @default(24)
  createdAt       DateTime    @default(now())
  jobs            Job[]
  candidates      Candidate[]
  matches         Match[]
  users           User[]
  auditLogs       AuditLog[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  email          String       @unique
  fullName       String
  passwordHash   String
  role           String       @default("RECRUITER")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions       Session[]
  auditLogs      AuditLog[]

  @@index([organizationId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String?
  entityId       String?
  details        String?
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId])
}

model Job {
  id             String   @id @default(cuid())
  organizationId String   @default("host-demo")
  title          String
  clientName     String?
  location       String?
  description    String
  mustHave       String
  shouldHave     String
  optional       String
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  matches        Match[]

  @@index([organizationId])
}

model Candidate {
  id              String   @id @default(cuid())
  organizationId  String   @default("host-demo")
  fullName        String
  email           String?
  location        String?
  sourceFileName  String?
  filePathname    String?
  fileContentType String?
  fileSize        Int?
  rawText         String
  summary         String
  skills          String
  experienceYears Int?
  dataSource      String   @default("CV_IMPORT")
  privacyNote     String?
  retentionUntil  DateTime?
  createdAt       DateTime @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  matches         Match[]

  @@index([organizationId])
  @@index([organizationId, email])
  @@index([organizationId, retentionUntil])
}

model Match {
  id             String    @id @default(cuid())
  organizationId String    @default("host-demo")
  jobId          String
  candidateId    String
  score          Int
  matched        String
  missing        String
  questions      String
  explanation    String
  stage          String    @default("NEW")
  recruiterNote  String?
  nextAction     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate    Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([jobId, candidateId])
  @@index([organizationId])
  @@index([stage])
  @@index([score])
}
