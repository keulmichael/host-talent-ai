# Sur Vercel, cette variable est créée automatiquement
# quand tu connectes Neon/Prisma Postgres au projet.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Couche IA générative optionnelle.
# Sans OPENAI_API_KEY, l'application continue de fonctionner avec le moteur
# déterministe actuel : aucune fonction existante ne dépend du LLM.
OPENAI_API_KEY=""
AI_MODEL="gpt-5-mini"
# Facultatif : endpoint compatible OpenAI. Laisser vide pour utiliser OpenAI.
# AI_API_URL="https://api.openai.com/v1/chat/completions"
